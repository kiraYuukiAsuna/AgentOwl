# Copy via make init. Secrets live in ./data/secrets, never in this file.
# Host Nginx is configured separately. Container ports bind to loopback only.
PUBLIC_URL=http://localhost:3000
WEB_PORT=3000
API_PORT=8080
APP_UID=1000
APP_GID=1000

# Keep these values unchanged when reusing an existing PostgreSQL data directory.
POSTGRES_DB=agentowl
POSTGRES_USER=agentowl

# Go dependency source for image builds; keep checksum verification enabled.
GOPROXY=https://proxy.golang.org,direct

# local is for a loopback development installation. Configure OIDC and HTTPS for production.
AUTH_MODE=local
BOOTSTRAP_EMAIL=admin@localhost
BOOTSTRAP_NAME=Administrator
BOOTSTRAP_SUBJECT=
OIDC_ISSUER=
OIDC_CLIENT_ID=

# Model credentials, daily budget and task execution limits are configured in the Web settings.

# make init generates a stable machine ID for first-start local registration.
# Runner starts after host setup, a pinned image and preflight succeed.
RUNNER_MACHINE_ID=
RUNNER_UID=1000
RUNNER_GID=1000
RUNNER_HOST_DATA_ROOT=
RUNNER_ALLOWED_IMAGES=

# Optional local-dev overrides; Docker always uses its private service addresses.
DEV_DATABASE_URL=
DEV_REDIS_URL=
